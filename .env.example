# Local development uses file:./local.db when this is omitted.
# Vercel MUST use a remote Turso database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
ADMIN_PASSWORD=replace-with-at-least-16-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
IMEI_MODEL_PATH=model
# Optional future IMEI provider:
IMEI_PROVIDER_URL=
IMEI_PROVIDER_TOKEN=
# Optional exact frontend origin:
CORS_ORIGIN=
SCRAPER_USER_AGENT=IMEISnap/1.0 (device image catalogue)
